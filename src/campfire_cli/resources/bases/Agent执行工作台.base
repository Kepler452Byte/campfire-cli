filters:
  and:
    - 'file.ext == "md"'
    - 'type == "task"'
    - 'list(assignee).contains("agent")'
properties:
  file.name: {displayName: 任务}
  project: {displayName: 项目}
  domain: {displayName: 领域}
  lifecycle: {displayName: 状态}
  priority: {displayName: 优先级}
  assignee: {displayName: 执行者}
  blocked_reason: {displayName: 阻塞原因}
  requires_human: {displayName: 需要确认}
  updated: {displayName: 更新时间}
views:
  - type: table
    name: Agent全部任务
    order: [file.name, project, lifecycle, priority, assignee, requires_human, updated]
  - type: table
    name: 执行中
    filters: 'lifecycle == "in-progress"'
    order: [file.name, project, priority, assignee, updated]
  - type: table
    name: 当前阻塞
    filters: 'lifecycle == "blocked"'
    order: [file.name, project, priority, assignee, blocked_reason, updated]
  - type: table
    name: 等待验收
    filters: 'lifecycle == "review"'
    order: [file.name, project, priority, assignee, updated]
  - type: table
    name: 最近完成
    filters: 'lifecycle == "completed" && completed >= today() - "30d"'
    order: [file.name, project, assignee, completed, updated]
