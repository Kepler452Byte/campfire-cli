filters:
  and:
    - 'file.ext == "md"'
    - 'file.path.startsWith("_收件箱/")'
properties:
  file.name: {displayName: 文档}
  file.folder: {displayName: 队列}
  type: {displayName: 类型}
  status: {displayName: 状态}
  created: {displayName: 创建日期}
  updated: {displayName: 更新日期}
views:
  - type: table
    name: 全部收件箱内容
    order: [file.name, file.folder, type, status, created, updated]
  - type: table
    name: 用户输入
    filters: 'file.path.startsWith("_收件箱/用户输入/")'
    order: [file.name, type, status, created, updated]
  - type: table
    name: 待用户确认
    filters: 'file.path.startsWith("_收件箱/待用户确认/")'
    order: [file.name, type, status, created, updated]
  - type: table
    name: 最近变化
    filters: 'file.mtime > now() - "30d"'
    order: [file.name, file.folder, status, file.mtime]
