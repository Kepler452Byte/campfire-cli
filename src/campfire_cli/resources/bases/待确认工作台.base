filters:
  and:
    - 'file.ext == "md"'
    - 'file.path.startsWith("_收件箱/待用户确认/待确认-Decision-")'
    - 'type == "human-request"'
properties:
  file.name: {displayName: 决策事项}
  description: {displayName: 说明}
  status: {displayName: 状态}
  created: {displayName: 创建日期}
  updated: {displayName: 更新时间}
views:
  - type: table
    name: 等待我确认
    order: [file.name, status, created, updated]
    sort:
      - property: updated
        direction: DESC
