filters:
  and:
    - 'file.ext == "md"'
    - 'document_status == "archived"'
properties:
  file.name: {displayName: 文档}
  type: {displayName: 类型}
  description: {displayName: 摘要}
  updated: {displayName: 更新时间}
  tags: {displayName: 标签}
views:
  - type: table
    name: 全部归档文档
    groupBy: {property: type, direction: ASC}
    order: [file.name, type, description, updated, tags]
    sort:
      - property: updated
        direction: DESC
