filters:
  and:
    - 'file.ext == "md"'
    - '!project.isEmpty()'
    - '!file.path.contains("/archive/")'
properties:
  file.name: {displayName: 文档}
  project: {displayName: 项目}
  domain: {displayName: 领域}
  type: {displayName: 类型}
  document_status: {displayName: 文档状态}
  lifecycle: {displayName: 生命周期}
  updated: {displayName: 更新时间}
views:
  - type: table
    name: 全部项目文档
    groupBy: {property: project, direction: ASC}
    order: [file.name, project, domain, type, document_status, lifecycle, updated]
  - type: table
    name: 当前权威文档
    filters: 'document_status == "current"'
    groupBy: {property: project, direction: ASC}
    order: [file.name, project, domain, type, lifecycle, updated]
  - type: table
    name: 草稿与提案
    filters: 'document_status == "draft" || lifecycle == "proposed"'
    order: [file.name, project, domain, type, document_status, lifecycle, updated]
  - type: table
    name: 进行中计划
    filters: 'type == "plan" && lifecycle != "archived"'
    order: [file.name, project, domain, document_status, lifecycle, updated]
  - type: table
    name: 未关闭问题
    filters: 'type == "issue" && lifecycle != "archived"'
    order: [file.name, project, domain, document_status, lifecycle, updated]
