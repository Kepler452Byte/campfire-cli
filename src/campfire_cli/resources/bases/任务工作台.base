filters:
  and:
    - 'file.ext == "md"'
    - 'type == "task"'
properties:
  file.name: {displayName: 任务}
  project: {displayName: 项目}
  domain: {displayName: 领域}
  task_source: {displayName: 来源}
  lifecycle: {displayName: 状态}
  priority: {displayName: 优先级}
  assignee: {displayName: 执行者}
  requires_human: {displayName: 需要确认}
  blocked_reason: {displayName: 阻塞原因}
  due: {displayName: 截止日期}
  updated: {displayName: 更新时间}
views:
  - type: table
    name: 全部任务
    order: [file.name, project, lifecycle, domain, task_source, priority, assignee, requires_human, due, updated]
    sort:
      - property: lifecycle
        direction: DESC
  - type: table
    name: 我的待确认
    filters: 'requires_human == true && lifecycle != "completed" && lifecycle != "archived"'
    order: [file.name, project, task_source, lifecycle, priority, blocked_reason, updated]
  - type: table
    name: 上级交办
    filters: 'task_source == "assigned" && lifecycle != "completed" && lifecycle != "archived"'
    groupBy: {property: project, direction: ASC}
    order: [file.name, lifecycle, priority, assignee, due, updated]
  - type: table
    name: 个人任务
    filters: 'task_source == "personal" && lifecycle != "completed" && lifecycle != "archived"'
    groupBy: {property: project, direction: ASC}
    order: [file.name, lifecycle, priority, assignee, due, updated]
  - type: table
    name: Agent执行中
    filters: 'list(assignee).contains("agent") && lifecycle == "in-progress"'
    order: [file.name, project, priority, due, updated]
  - type: table
    name: 当前阻塞
    filters: 'lifecycle == "blocked"'
    order: [file.name, project, task_source, priority, blocked_reason, updated]
  - type: table
    name: 等待验收
    filters: 'lifecycle == "review"'
    order: [file.name, project, task_source, assignee, updated]
  - type: table
    name: 最近完成
    filters: 'lifecycle == "completed" && completed >= today() - "30d"'
    order: [file.name, project, task_source, completed, updated]
